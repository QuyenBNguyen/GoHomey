{
  "cli": {
    "version": ">= 16.23.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "ENVIRONMENT": "development",
        "API_BASE": "https://gohomey.me"
      }
    },
    "preview": {
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ENVIRONMENT": "production",
        "API_BASE": "https://gohomey.me",
        "MAP_ATTRIBUTION": "© Geoapify"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "ENVIRONMENT": "production",
        "API_BASE": "https://gohomey.me",
        "MAP_ATTRIBUTION": "© Geoapify"
      }
    }
  },
  "submit": {
    "production": {}
  }
}